{
    "metadata": {
        "revision": 1,
        "name": "Lucius Editor"
    },
    "text-styles": {
        "Normal": {
            "text-color": "#444444",
            "selected-text-color": "#444444",
            "bold": false,
            "italic": false,
            "underline": false,
            "strike-through": false
        },
        "Keyword": {
            "text-color": "#005faf",
            "selected-text-color": "#444444"
        },
        "Function": {
            "text-color": "#008700",
            "selected-text-color": "#444444"
        },
        "Variable": {
            "text-color": "#008700",
            "selected-text-color": "#444444"
        },
        "ControlFlow": {
            "text-color": "#005faf",
            "selected-text-color": "#444444"
        },
        "Operator": {
            "text-color": "#005faf",
            "selected-text-color": "#444444"
        },
        "BuiltIn": {
            "text-color": "#008700",
            "selected-text-color": "#444444"
        },
        "Extension": {
            "text-color": "#008700",
            "selected-text-color": "#444444"
        },
        "Preprocessor": {
            "text-color": "#008787",
            "selected-text-color": "#444444"
        },
        "Attribute": {
            "text-color": "#008700",
            "selected-text-color": "#444444"
        },
        "Char": {
            "text-color": "#af5f00",
            "selected-text-color": "#444444"
        },
        "SpecialChar": {
            "text-color": "#870087",
            "selected-text-color": "#444444"
        },
        "String": {
            "text-color": "#af5f00",
            "selected-text-color": "#444444"
        },
        "VerbatimString": {
            "text-color": "#af5f00",
            "selected-text-color": "#444444"
        },
        "SpecialString": {
            "text-color": "#870087",
            "selected-text-color": "#444444"
        },
        "Import": {
            "text-color": "#008787",
            "selected-text-color": "#444444"
        },
        "DataType": {
            "text-color": "#005f87",
            "selected-text-color": "#444444"
        },
        "DecVal": {
            "text-color": "#af5f00",
            "selected-text-color": "#444444"
        },
        "BaseN": {
            "text-color": "#af5f00",
            "selected-text-color": "#444444"
        },
        "Float": {
            "text-color": "#af5f00",
            "selected-text-color": "#444444"
        },
