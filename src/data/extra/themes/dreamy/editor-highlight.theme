        "selection": "#d4b6e0",
        "separator": "#d4b6e0",
        "spell-checking": "#ad354b",
        "tab-marker": "#c8acd4",
        "template-background": "#f3e5f5",
        "template-placeholder": "#d4b6e0",
        "template-focused-placeholder": "#c8acd4",
        "template-read-only-placeholder": "#f3e5f5",
        "word-wrap-marker": "#d4b6e0"
    }
