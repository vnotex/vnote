{
    "metadata": {
        "revision": 2,
        "name": "Dreamy Editor",
        "description": "Light syntax coordinated with Phycat Mauve (https://github.com/sumruler/typora-theme-phycat)"
    },
    "text-styles": {
        "Normal": {
            "text-color": "#333333",
            "selected-text-color": "#4a235a",
            "bold": false,
            "italic": false,
            "underline": false,
            "strike-through": false
        },
        "Keyword": {
            "text-color": "#6a3f7a",
            "selected-text-color": "#4a235a"
        },
        "Function": {
