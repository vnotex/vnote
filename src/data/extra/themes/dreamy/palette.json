        "unitedentry" : {
            "icon" : {
                "fg" : "@base#icon#fg",
                "busy" : {
                    "fg" : "@palette#fg_link"
                }
            },
            "popup" : {
                "border" : "@base#normal#border"
            }
        },
        "settingscard" : {
            "bg" : "@base#content#bg",
            "border" : "@base#normal#border",
            "title" : {
                "fg" : "@base#content#fg"
            },
            "description" : {
                "fg" : "@base#muted#fg"
            },
            "separator" : {
                "bg" : "@base#normal#border"
            }
        }
    }
}
